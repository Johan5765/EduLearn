@model List<Aula.ViewModels.MiCursoVM>
@{
    ViewData["Title"] = "Mis cursos";
}

<div class="container-fluid py-4">

    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold mb-1">Mis cursos</h1>
            <p class="text-muted mb-0">Los cursos en los que estás inscrito.</p>
        </div>
        <a class="btn btn-outline-primary" asp-action="Catalogo">Explorar catálogo</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-light border text-center py-4">
            Aún no estás inscrito en ningún curso.
            <a asp-action="Catalogo">Ver el catálogo</a>
        </div>
    }

    <div class="row g-3">
        @foreach (var c in Model)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex flex-column">

                        <h2 class="h5 fw-bold mb-1 text-break">@c.Titulo</h2>
                        <p class="small text-muted mb-2">
                            Profesor: @(c.Profesor ?? "Sin asignar")
                        </p>

                        <p class="text-muted mb-3"
                           style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">
                            @(string.IsNullOrWhiteSpace(c.Descripcion) ? "Sin descripción." : c.Descripcion)
                        </p>

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge text-bg-light border text-dark">@c.TotalLecciones lecciones</span>
                            <span class="badge text-bg-light border text-dark">
                                Inscrito el @c.FechaInscripcion.ToString("dd/MM/yyyy")
                            </span>
                        </div>

                        <div class="mt-auto d-flex gap-2">
                            <a class="btn btn-primary flex-grow-1"
                               asp-controller="Curso" asp-action="Gestionar" asp-route-id="@c.CursoId">
                                Entrar al curso
                            </a>

                            <form asp-action="CancelarInscripcion" asp-route-cursoId="@c.CursoId" method="post"
                                  onsubmit="return confirm('¿Cancelar tu inscripción a este curso?');">
                                <button type="submit" class="btn btn-outline-danger">Cancelar</button>
                            </form>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>
