@model Aula.ViewModels.InscritosVM
@{
    ViewData["Title"] = "Inscritos";
}

<div class="container py-4" style="max-width: 860px;">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Curso" asp-action="Index" class="text-decoration-none">Mis cursos</a></li>
            <li class="breadcrumb-item">
                <a asp-controller="Curso" asp-action="Gestionar" asp-route-id="@Model.CursoId" class="text-decoration-none">@Model.CursoTitulo</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Inscritos</li>
        </ol>
    </nav>

    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <h1 class="h3 fw-bold mb-1">Estudiantes inscritos</h1>
    <p class="text-muted mb-4">@Model.CursoTitulo · @Model.Inscritos.Count inscritos</p>

    <!-- Inscribir manualmente -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h2 class="h6 fw-bold mb-3">Inscribir un estudiante</h2>

            @if (Model.Disponibles.Any())
            {
                <form asp-action="AgregarEstudiante" method="post" class="row g-2">
                    <input type="hidden" name="cursoId" value="@Model.CursoId" />

                    <div class="col-12 col-md">
                        <select name="estudianteId" class="form-select" required aria-label="Estudiante">
                            <option value="">Selecciona un estudiante…</option>
                            @foreach (var e in Model.Disponibles)
                            {
                                <option value="@e.Id">@e.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-auto">
                        <button type="submit" class="btn btn-primary w-100">Inscribir</button>
                    </div>
                </form>
            }
            else
            {
                <p class="text-muted mb-0">No hay más estudiantes disponibles para inscribir.</p>
            }
        </div>
    </div>

    <!-- Lista -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (Model.Inscritos.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Estudiante</th>
                                <th>Inscrito el</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Model.Inscritos)
                            {
                                <tr>
                                    <td>@i.Nombre</td>
                                    <td>@i.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">
                                        <form asp-action="QuitarEstudiante" asp-route-id="@i.InscripcionId" method="post"
                                              onsubmit="return confirm('¿Quitar a este estudiante del curso?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Quitar</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted text-center py-4 mb-0">Este curso todavía no tiene estudiantes inscritos.</p>
            }
        </div>
    </div>

    <div class="mt-4">
        <a class="btn btn-outline-secondary" asp-controller="Curso" asp-action="Gestionar" asp-route-id="@Model.CursoId">Volver al curso</a>
    </div>
</div>
