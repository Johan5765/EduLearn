@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var accion = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var autenticado = User.Identity?.IsAuthenticated == true;
    var esAdmin = User.IsInRole("Administrador");
    var esProfesor = User.IsInRole("Profesor");
    var esEstudiante = User.IsInRole("Estudiante");

    var rol = esAdmin ? "Administrador" : esProfesor ? "Profesor" : esEstudiante ? "Estudiante" : "";
    var nombre = User.Identity?.Name ?? "Usuario";

    // Marca el enlace de la sección actual
    string Activo(string c, string? a = null) =>
        controlador == c && (a == null || accion == a) ? "active" : "";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduLearn</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Aula.styles.css" asp-append-version="true" />
</head>

<body class="bg-body-secondary">
    <header>
        <nav class="navbar navbar-expand-md navbar-dark shadow-sm mb-4"
             style="background-color: #1d2b4f;">
            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    EduLearn
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Mostrar u ocultar el menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menuPrincipal">

                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        @if (autenticado)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Activo("Home")"
                                   asp-area=""
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Inicio
                                </a>
                            </li>
                        }
                        

                        @if (esEstudiante)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Activo("Inscripciones", "Catalogo")"
                                   asp-area=""
                                   asp-controller="Inscripciones"
                                   asp-action="Catalogo">
                                    Catálogo
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @Activo("Inscripciones", "MisCursos")"
                                   asp-area=""
                                   asp-controller="Inscripciones"
                                   asp-action="MisCursos">
                                    Mis cursos
                                </a>
                            </li>
                        }

                        @if (esProfesor || esAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Activo("Curso")"
                                   asp-area=""
                                   asp-controller="Curso"
                                   asp-action="Index">
                                    @(esAdmin ? "Cursos" : "Mis cursos")
                                </a>
                            </li>
                        }

                        @if (esAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Activo("Usuario")"
                                   asp-area=""
                                   asp-controller="Usuario"
                                   asp-action="Index">
                                    Usuarios
                                </a>
                            </li>
                        }
                    </ul>


                    <div class="d-flex align-items-center gap-3 text-white">

                        @if (autenticado)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center fw-bold"
                                     style="width: 36px; height: 36px;">
                                    @(string.IsNullOrEmpty(nombre) ? "U" : nombre.Substring(0, 1).ToUpper())
                                </div>

                                <div class="d-flex flex-column">
                                    <span class="fw-semibold small">@nombre</span>

                                    @if (!string.IsNullOrEmpty(rol))
                                    {
                                        <span class="text-white-50" style="font-size: 0.75rem;">
                                            @rol
                                        </span>
                                    }
                                </div>
                            </div>

                            <form asp-area=""
                                  asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="d-inline">
                                <button type="submit"
                                        class="btn btn-outline-light btn-sm rounded-3 px-3">
                                    Salir
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-light btn-sm rounded-3 px-3 fw-semibold"
                               asp-area=""
                               asp-controller="Account"
                               asp-action="Login">
                                Iniciar sesión
                            </a>
                        }

                    </div>


                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container text-center">
            &copy; 2026 EduLearn
        </div>
    </footer>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
