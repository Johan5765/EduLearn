@model Aula.ViewModels.EvaluacionFormViewModel
@{
    ViewData["Title"] = "Crear evaluación";
}

<div class="container py-4" style="max-width: 680px;">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Curso" asp-action="Index" class="text-decoration-none">Mis cursos</a></li>
            <li class="breadcrumb-item">
                <a asp-controller="Curso" asp-action="Gestionar" asp-route-id="@Model.CursoId" class="text-decoration-none">Curso</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Crear evaluación</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h1 class="h4 fw-bold mb-1">Crear evaluación</h1>
            <p class="text-muted mb-4">Lección: @Model.LeccionTitulo</p>

            <form asp-action="Crear" method="post">
                <input type="hidden" asp-for="LeccionId" />
                <input type="hidden" asp-for="CursoId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-4">
                    <label asp-for="Titulo" class="form-label fw-semibold">Título de la evaluación</label>
                    <input asp-for="Titulo" class="form-control" placeholder="Ej: Evaluación 1: Conceptos básicos" />
                    <span asp-validation-for="Titulo" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-dark">Crear y agregar preguntas</button>
                    <a class="btn btn-outline-secondary" asp-controller="Curso" asp-action="Gestionar" asp-route-id="@Model.CursoId">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
