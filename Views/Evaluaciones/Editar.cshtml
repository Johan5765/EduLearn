@model Aula.ViewModels.EvaluacionEditViewModel
@{
    ViewData["Title"] = "Editar evaluación";
}

<div class="container py-4" style="max-width: 760px;">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Curso" asp-action="Index" class="text-decoration-none">Mis cursos</a></li>
            <li class="breadcrumb-item">
                <a asp-controller="Curso" asp-action="Gestionar" asp-route-id="@Model.CursoId" class="text-decoration-none">Curso</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Editar evaluación</li>
        </ol>
    </nav>

    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Ok"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Título -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h1 class="h4 fw-bold mb-1">Editar evaluación</h1>
            <p class="text-muted mb-4">Lección: @Model.LeccionTitulo</p>

            <form asp-action="Editar" asp-route-id="@Model.Id" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Titulo" class="form-label fw-semibold">Título</label>
                    <input asp-for="Titulo" class="form-control" />
                    <span asp-validation-for="Titulo" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-sm">Guardar título</button>
            </form>
        </div>
    </div>

    <!-- Preguntas -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h2 class="h5 fw-bold mb-3">
                Preguntas
                <span class="badge text-bg-light border text-dark">@Model.Preguntas.Count</span>
            </h2>

            @if (Model.Preguntas.Any())
            {
                @foreach (var p in Model.Preguntas)
                {
                    <div class="border rounded p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                            <strong>@p.Enunciado</strong>
                            <form asp-action="EliminarPregunta" asp-route-id="@p.Id" method="post"
                                  onsubmit="return confirm('¿Eliminar esta pregunta y sus opciones?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Quitar</button>
                            </form>
                        </div>

                        <h3 class="h6">Opciones de respuesta</h3>

                        @if (p.Opciones.Any())
                        {
                            @foreach (var opcion in p.Opciones)
                            {
                                <div class="d-flex justify-content-between align-items-center gap-2 border rounded p-2 mb-2">
                                    <div class="text-break">
                                        @opcion.Texto
                                        @if (opcion.EsCorrecta)
                                        {
                                            <span class="badge text-bg-success ms-1">Correcta</span>
                                        }
                                    </div>
                                    <div class="d-flex gap-1">
                                        @if (!opcion.EsCorrecta)
                                        {
                                            <form asp-action="MarcarOpcionCorrecta" method="post">
                                                <input type="hidden" name="id" value="@opcion.Id" />
                                                <button class="btn btn-outline-success btn-sm" type="submit">Marcar correcta</button>
                                            </form>
                                        }
                                        <form asp-action="EliminarOpcion" asp-route-id="@opcion.Id" method="post"
                                              onsubmit="return confirm('¿Eliminar esta opción?');">
                                            <button class="btn btn-outline-danger btn-sm" type="submit">Quitar</button>
                                        </form>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted small">Esta pregunta todavía no tiene opciones.</p>
                        }

                        <form asp-action="AgregarOpcion" method="post" class="mt-3">
                            <input type="hidden" name="preguntaId" value="@p.Id" />
                            <label class="form-label">Nueva opción</label>
                            <input type="text" name="texto" class="form-control mb-2"
                                   maxlength="300" required placeholder="Escribe una respuesta" />
                            <div class="form-check mb-2">
                                <input type="checkbox" name="esCorrecta" value="true"
                                       class="form-check-input" id="correcta_@p.Id" />
                                <label class="form-check-label" for="correcta_@p.Id">Es la respuesta correcta</label>
                            </div>
                            <button type="submit" class="btn btn-outline-primary btn-sm">Agregar opción</button>
                        </form>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">Esta evaluación todavía no tiene preguntas.</p>
            }

            <hr />

            <form asp-action="AgregarPregunta" method="post">
                <input type="hidden" name="evaluacionId" value="@Model.Id" />
                <label for="enunciado" class="form-label fw-semibold">Nueva pregunta</label>
                <textarea id="enunciado" name="enunciado" class="form-control mb-2"
                          rows="3" maxlength="500" required
                          placeholder="Escribe el enunciado de la pregunta"></textarea>
                <button type="submit" class="btn btn-dark btn-sm">+ Agregar pregunta</button>
            </form>
        </div>
    </div>

    <!-- Zona de peligro y volver -->
    <div class="d-flex justify-content-between">
        <a class="btn btn-outline-secondary" asp-controller="Curso" asp-action="Gestionar" asp-route-id="@Model.CursoId">
            Volver al curso
        </a>

        <form asp-action="Eliminar" asp-route-id="@Model.Id" method="post"
              onsubmit="return confirm('¿Eliminar esta evaluación y todas sus preguntas?');">
            <button type="submit" class="btn btn-outline-danger">Eliminar evaluación</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
